{
  "name": "gist-test-automation",
  "version": "1.0.0",
  "description": "Test automation solution for GitHub Gist (REST API + UI)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --project=api",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui --workers=1",
    "test:ui:debug": "playwright test --project=ui --workers=1 --debug",
    "test:ui:headed": "playwright test --project=ui --workers=1 --headed",
    "test:all": "npm run test:api && npm run test:ui",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "cleanup": "tsx scripts/cleanup.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-playwright": "^2.10.5",
    "otpauth": "^9.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  }
}
